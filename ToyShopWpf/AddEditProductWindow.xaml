<Window x:Class="ToyShopWpf.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToyShopWpf"
        mc:Ignorable="d"
        Style="{StaticResource Windows}"
        Title="Редактирование данных о продукте" Height="800" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Margin="20 0">
                <TextBlock Text="Артикул"/>
                <TextBox Text="{Binding Articul}" MaxLength="50"/>
                
                <TextBlock Text="Название" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Name}"/>
                
                <TextBlock Text="Единица измерения" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Name"/>
                
                <TextBlock Text="Цена" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Price}"/>
                
                <TextBlock Text="Поставщик" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="Name"/>
                
                <TextBlock Text="Производитель" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding Creators}" SelectedItem="{Binding SelectedCreator}" DisplayMemberPath="Name"/>
                
                <TextBlock Text="Категория" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"/>
                
                <TextBlock Text="Скидка (%)" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Discount}"/>
                
                <TextBlock Text="Количество на складе" Margin="0,10,0,0"/>
                <TextBox Text="{Binding AmountInStock}"/>
                
                <TextBlock Text="Описание" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="100" TextWrapping="Wrap"/>
                
                <TextBlock Text="Путь к изображению" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Photo}"/>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" 
                Content="Отменить"
                Command="{Binding CancelCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="20 0"
                />
        <Button Grid.Row="1" 
                Content="Сохранить"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="20 0"
                />

    </Grid>
</Window>
